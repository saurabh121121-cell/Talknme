<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TalkNMe — Someone to Talk To, Whenever You Need</title><style>:root{--ink:#17202a;--muted:#68717a;--pink:#c85b7a;--purple:#9d3fbd;--soft:#fff7f9;--line:#ece8e5;--green:#16834a}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:system-ui,-apple-system,BlinkMacSystemFont,sans-serif;color:var(--ink);background:#fff}nav{height:72px;display:flex;justify-content:space-between;align-items:center;padding:0 5%;border-bottom:1px solid var(--line);position:sticky;top:0;background:#fff;z-index:5}.logo{font-size:26px;font-weight:900}.logo span{color:var(--pink)}nav a{margin:0 10px;text-decoration:none;color:var(--ink);font-size:14px;font-weight:700}button{border:0;border-radius:12px;padding:13px 18px;font-weight:800;cursor:pointer;background:linear-gradient(90deg,#8d39c7,#d4478d);color:#fff}.dark{background:#17202a}.hero{padding:58px 5%;background:radial-gradient(circle at 90% 20%,#ffe8f0 0,transparent 34%),linear-gradient(110deg,#fff 45%,#fff0f5)}.hero-in{max-width:1200px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:42px;align-items:center}.pill{display:inline-block;background:#ffe2eb;color:#9d405e;border-radius:30px;padding:8px 13px;font-size:12px;font-weight:900}.live{display:inline-flex;align-items:center;gap:7px;margin-left:8px;color:var(--green);font-size:12px;font-weight:800}.dot{width:8px;height:8px;border-radius:50%;background:#25a65a}h1{font-size:clamp(44px,6vw,70px);line-height:.98;letter-spacing:-3px;margin:18px 0}h1 span{color:var(--purple)}.hero p{font-size:19px;color:var(--muted);line-height:1.55}.actions{display:flex;gap:12px;margin-top:24px}.trust{display:flex;gap:22px;color:var(--muted);font-size:13px;margin-top:20px;flex-wrap:wrap}.hero-img{width:100%;height:430px;object-fit:cover;border-radius:28px;box-shadow:0 20px 50px #c85b7a24}.strip{display:grid;grid-template-columns:repeat(4,1fr);max-width:1100px;margin:-24px auto 0;background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:0 12px 35px #0000000c;position:relative;z-index:2}.strip div{padding:17px;text-align:center;border-right:1px solid var(--line);font-size:13px}.strip div:last-child{border:0}.strip b{display:block;font-size:15px;margin-bottom:3px}.muted{color:var(--muted)}section{padding:60px 5%;max-width:1300px;margin:auto}h2{font-size:36px;margin:0 0 8px}.lead{color:var(--muted);margin-bottom:28px}.profiles{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{border:1px solid var(--line);border-radius:20px;overflow:hidden;background:#fff;box-shadow:0 8px 25px #0000000d;transition:.2s}.card:hover{transform:translateY(-4px);box-shadow:0 15px 35px #00000014}.card>img{width:100%;height:245px;object-fit:cover;display:block;background:#f4e9ee}.body{padding:17px}.name{font-weight:900;font-size:19px;display:flex;justify-content:space-between;gap:10px}.name span{font-size:10px;color:var(--green);white-space:nowrap}.body p{font-size:13px;color:var(--muted);line-height:1.45;min-height:38px}.tags{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0 14px}.tags b{font-size:11px;background:#f4f2f0;color:#626a71;border-radius:20px;padding:6px 9px}.row{display:flex;justify-content:space-between;align-items:center}em{font-style:normal;color:#9d405e;font-size:12px}.card button{width:100%;margin-top:12px}.pricing,.reviews{background:var(--soft)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.box{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px}.box p{color:var(--muted);font-size:13px;line-height:1.5}.price{font-size:22px;font-weight:900;color:#9d405e}.center{text-align:center}.type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:35px}.type{background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;cursor:pointer;transition:.2s}.type:hover{transform:translateY(-3px);border-color:#d47794}.type .price{margin-top:15px}.packages{margin-top:34px}.package-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;align-items:stretch}.package{position:relative;background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px 18px;text-align:center;box-shadow:0 8px 25px #0000000b}.package.featured{border:2px solid #d05b81;transform:translateY(-7px);box-shadow:0 14px 32px #c85b7a2b}.badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:linear-gradient(90deg,#8d39c7,#d4478d);color:#fff;border-radius:20px;padding:5px 12px;font-size:11px;font-weight:900;white-space:nowrap}.package h3{margin:5px 0 7px;font-size:20px}.mins{font-size:13px;color:var(--muted);margin-bottom:15px}.pkg-price{font-size:29px;font-weight:950;color:#9d405e}.per{font-size:11px;color:var(--muted);margin:3px 0 15px}.package button{width:100%;font-size:13px}.package-note{font-size:12px;color:var(--muted);text-align:center;margin:18px 0 0}.save{display:inline-block;background:#e7f7ed;color:var(--green);border-radius:20px;padding:5px 9px;font-size:11px;font-weight:900;margin-top:8px}.privacy{display:grid;grid-template-columns:1.1fr 1fr;gap:25px;align-items:stretch}.privacy-card{background:#17202a;color:#fff;border-radius:24px;padding:30px}.privacy-card p{color:#c8cdd2;line-height:1.6}.checks{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px}.checks div{background:#fff;border:1px solid var(--line);border-radius:15px;padding:17px}.checks b{display:block;margin-bottom:5px}.reviews .box{min-height:125px}.faq{max-width:900px}.faq-item{background:#fff;border:1px solid var(--line);border-radius:15px;padding:18px;margin:10px 0}.faq-item b{display:block;margin-bottom:6px}.faq-item p{margin:0;color:var(--muted);font-size:14px}.footer{padding:25px 5%;border-top:1px solid var(--line);display:flex;justify-content:space-between;color:#777;font-size:12px}.modal{display:none;position:fixed;inset:0;background:#0008;align-items:center;justify-content:center;z-index:10;padding:20px}.modalbox{background:#fff;padding:25px;border-radius:20px;max-width:400px;width:100%;box-shadow:0 20px 60px #0004}.modalbox input{width:100%;padding:14px;border:1px solid #ddd;border-radius:10px;margin:12px 0;font-size:16px}.status{display:none;margin-top:12px;color:var(--muted);font-size:13px}@media(max-width:950px){.package-grid{grid-template-columns:repeat(2,1fr)}.strip{margin:20px 5% 0}.privacy{grid-template-columns:1fr}}@media(max-width:850px){.hero-in{grid-template-columns:1fr}.hero-img{height:330px}.profiles,.grid,.type-grid{grid-template-columns:1fr 1fr}.strip{grid-template-columns:1fr 1fr}.strip div:nth-child(2){border-right:0}}@media(max-width:560px){nav a{display:none}.profiles,.grid,.type-grid,.package-grid,.checks{grid-template-columns:1fr}.hero-img{height:300px}.trust{flex-direction:column;gap:7px}.actions{flex-wrap:wrap}.package.featured{transform:none}.strip{grid-template-columns:1fr 1fr}.strip div{border-bottom:1px solid var(--line)}.strip div:nth-child(2){border-right:0}.footer{flex-direction:column;gap:8px}} </style></head><body><nav><div class="logo">TalkN<span>Me</span></div><div><a href="#people">Listeners</a><a href="#pricing">Pricing</a><a href="#how">How it works</a><a href="#reviews">Reviews</a><button class="dark" onclick="openModal()">Talk Now</button></div></nav><header class="hero"><div class="hero-in"><div><span class="pill">PRIVATE • PAY AS YOU TALK</span><span class="live"><i class="dot"></i> Available listeners</span><h1>Need someone<br>to <span>talk to?</span></h1><p>Have something on your mind? Talk privately with a friendly listener — for a casual chat, relationship situation, life advice or simply someone who listens.</p><div class="actions"><button onclick="openModal()">Talk Now →</button><button class="dark" onclick="document.getElementById('people').scrollIntoView()">Meet listeners</button></div><div class="trust"><span>✓ No subscription</span><span>✓ Secure payment</span><span>✓ Stop whenever you want</span></div></div><img class="hero-img" src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=1000&q=85" alt="Person talking on the phone"></div></header><div class="strip"><div><b>🔒 Private</b><span class="muted">Your conversation stays personal</span></div><div><b>💳 Pay as you talk</b><span class="muted">No monthly subscription</span></div><div><b>⏱ Flexible</b><span class="muted">Choose your time</span></div><div><b>💬 Real connection</b><span class="muted">Talk about what matters</span></div></div><section id="people"><div class="center"><h2>Meet your listeners</h2><p class="lead">Choose someone by personality, interests and conversation style.</p></div><div class="profiles"><article class="card"><img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=1200&q=92" alt="Sarah"><div class="body"><div class="name">Sarah <span>● AVAILABLE NOW</span></div><p>Warm, empathetic and easy to open up to.</p><div class="tags"><b>Relationships</b><b>Dating</b></div><div class="row"><strong>$2.00/min</strong><em>★ 4.9</em></div><button onclick="openModal()">Talk to Sarah →</button></div></article><article class="card"><img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=1200&q=92" alt="Maya"><div class="body"><div class="name">Maya <span>● AVAILABLE NOW</span></div><p>Fun, upbeat and great for a relaxed conversation.</p><div class="tags"><b>Friendly talk</b><b>Life</b></div><div class="row"><strong>$1.75/min</strong><em>★ 4.8</em></div><button onclick="openModal()">Talk to Maya →</button></div></article><article class="card"><img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=1200&q=92" alt="Emma"><div class="body"><div class="name">Emma <span>● AVAILABLE NOW</span></div><p>Calm, caring and especially good for late-night talks.</p><div class="tags"><b>Just talk</b><b>Late night</b></div><div class="row"><strong>$2.25/min</strong><em>★ 5.0</em></div><button onclick="openModal()">Talk to Emma →</button></div></article><article class="card"><img src="https://images.unsplash.com/photo-1488426862026-3ee34a7d66df?auto=format&fit=crop&w=1200&q=92" alt="Ava"><div class="body"><div class="name">Ava <span>● AVAILABLE NOW</span></div><p>Thoughtful, confident and good at offering another perspective.</p><div class="tags"><b>Advice</b><b>Perspective</b></div><div class="row"><strong>$2.50/min</strong><em>★ 4.9</em></div><button onclick="openModal()">Talk to Ava →</button></div></article><article class="card"><img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=1200&q=92" alt="Daniel"><div class="body"><div class="name">Daniel <span>● AVAILABLE NOW</span></div><p>Calm, thoughtful and a good listener when you need perspective.</p><div class="tags"><b>Life advice</b><b>Perspective</b></div><div class="row"><strong>$2.00/min</strong><em>★ 4.9</em></div><button onclick="openModal()">Talk to Daniel →</button></div></article><article class="card"><img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=1200&q=92" alt="Chris"><div class="body"><div class="name">Chris <span>● AVAILABLE NOW</span></div><p>Easygoing, friendly and great for casual conversation.</p><div class="tags"><b>Friendly talk</b><b>Travel</b></div><div class="row"><strong>$1.75/min</strong><em>★ 4.8</em></div><button onclick="openModal()">Talk to Chris →</button></div></article></div></section><section class="pricing" id="pricing"><div class="center"><h2>What do you want to talk about?</h2><p class="lead">Choose a conversation style, then choose how much time you want.</p></div><div class="type-grid"><div class="type" onclick="openModal()"><h3>💬 Casual Conversation</h3><p class="muted">Your day, interests, travel, hobbies or anything on your mind.</p><div class="price">$1.75 / min</div></div><div class="type" onclick="openModal()"><h3>❤️ Relationship & Dating</h3><p class="muted">Dating situations, relationship questions and difficult decisions.</p><div class="price">$2.00 / min</div></div><div class="type" onclick="openModal()"><h3>🧠 Life Advice & Perspective</h3><p class="muted">Another person's perspective when you're thinking something through.</p><div class="price">$2.00 / min</div></div></div><div class="packages"><div class="center"><h2>Pick your time</h2><p class="lead">More time, better value.</p></div><div class="package-grid"><div class="package"><h3>10 Minutes</h3><div class="mins">Quick chat · Try it out</div><div class="pkg-price">$17.50</div><span class="save">Pay-as-you-talk rate</span><div class="per">Casual · $1.75/min</div><button onclick="openModal()">Start 10 minutes</button></div><div class="package"><h3>20 Minutes</h3><div class="mins">A little more time to talk</div><div class="pkg-price">$32</div><span class="save">Save $3</span><div class="per">Casual · $1.60/min</div><button onclick="openModal()">Start 20 minutes</button></div><div class="package featured"><span class="badge">⭐ MOST POPULAR</span><h3>30 Minutes</h3><div class="mins">Relaxed conversation</div><div class="pkg-price">$45</div><span class="save">Save $7.50</span><div class="per">Casual · $1.50/min</div><button onclick="openModal()">Start 30 minutes</button></div><div class="package"><h3>60 Minutes</h3><div class="mins">A full hour to talk</div><div class="pkg-price">$84</div><span class="save">Save $21</span><div class="per">Casual · $1.40/min</div><button onclick="openModal()">Start 60 minutes</button></div></div><p class="package-note">Relationship & Dating and Life Advice packages are also available at $20 / $36 / $52 / $96 for 10 / 20 / 30 / 60 minutes.</p></div></section><section><div class="privacy"><div class="privacy-card"><h2>🔒 Your conversation. Your privacy.</h2><p>Talk about what matters without committing to a subscription. Choose your time, start your conversation and stop whenever you're ready.</p><button onclick="openModal()">Start a private conversation →</button></div><div class="checks"><div><b>✓ No subscription</b><span class="muted">Pay only for the time you choose.</span></div><div><b>✓ Secure payment</b><span class="muted">Use the secure payment flow.</span></div><div><b>✓ Flexible time</b><span class="muted">10 minutes or a full hour.</span></div><div><b>✓ Easy to start</b><span class="muted">Choose a listener and begin.</span></div></div></div></section><section class="reviews" id="reviews"><div class="center"><h2>What people are saying</h2><p class="lead">Real customer reviews will appear here as genuine conversations happen.</p></div><div class="grid"><div class="box">★★★★★<p>Verified customer feedback will appear here.</p><b>Verified feedback</b></div><div class="box">★★★★★<p>Real listener experiences will be displayed here.</p><b>Verified feedback</b></div><div class="box">★★★★★<p>We will build this section with genuine reviews.</p><b>Verified feedback</b></div></div></section><section id="how"><div class="center"><h2>Start with a simple hello.</h2><p class="lead">Three simple steps.</p></div><div class="grid"><div class="box"><h3>1. Choose someone</h3><p>Browse profiles, personalities, interests and availability.</p></div><div class="box"><h3>2. Start talking</h3><p>Enter your email and continue to the secure call.</p></div><div class="box"><h3>3. Pay as you talk</h3><p>No subscription. Pay based on the package or time you choose.</p></div></div></section><section class="faq"><div class="center"><h2>Questions? We've got you.</h2></div><div class="faq-item"><b>Is this a subscription?</b><p>No. Choose a package or pay according to the available conversation rate.</p></div><div class="faq-item"><b>Can I stop whenever I want?</b><p>Yes. You choose how much time you want to talk.</p></div><div class="faq-item"><b>How do I start?</b><p>Choose a listener or package, enter your email and continue to the secure call.</p></div><div class="faq-item"><b>Will my reviews be genuine?</b><p>Yes. Customer feedback will be added as real conversations take place.</p></div></section><footer class="footer"><span>© 2026 TalkNMe</span><span>Terms · Privacy · Safety · Refunds · Contact</span></footer><div class="modal" id="modal"><div class="modalbox"><button style="float:right;background:none;color:#17202a;font-size:22px;padding:0" onclick="closeModal()">×</button><h3>Start your conversation</h3><p style="color:#68717a">Enter your email to continue to the secure call.</p><input id="email" type="email" autocomplete="email" placeholder="you@example.com"><button id="continueBtn" style="width:100%" onclick="startCall()">Continue to call</button><div class="status" id="status">Opening your secure call…</div></div></div><script>const DAILY_ROOM='https://talknme.daily.co/Talknme';function openModal(){document.getElementById('modal').style.display='flex';setTimeout(()=>document.getElementById('email').focus(),50)}function closeModal(){document.getElementById('modal').style.display='none'}function startCall(){const input=document.getElementById('email');const email=input.value.trim();if(!email||!input.checkValidity()){input.focus();input.reportValidity();return}localStorage.setItem('talknme_email',email);document.getElementById('continueBtn').disabled=true;document.getElementById('continueBtn').textContent='Opening call…';document.getElementById('status').style.display='block';setTimeout(()=>{window.location.href=DAILY_ROOM},250)}window.addEventListener('click',e=>{if(e.target.id==='modal')closeModal()});window.addEventListener('DOMContentLoaded',()=>{const saved=localStorage.getItem('talknme_email');if(saved)document.getElementById('email').value=saved});</script></body></html>